# Supabase接続情報（このファイルはテンプレートです。実際の値は .env.local に設定してください）

# クライアント側（ブラウザ）から読む値
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# サーバー側（APIルート）でのみ使う値。クライアントに公開しないこと
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ログイン用の合言葉。アカウント登録なしの単一パスワード認証に使う
APP_PASSWORD=your-login-password-here

# ログインCookieの署名専用の秘密鍵（APP_PASSWORDとは別の値にすること）
AUTH_COOKIE_SECRET=your-random-secret-here

# おすすめ本生成（Claude API）用のAPIキー
ANTHROPIC_API_KEY=your-anthropic-api-key-here
